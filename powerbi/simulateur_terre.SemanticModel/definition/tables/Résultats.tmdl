	measure 'H moules 2024' = 48775
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 1a9d15e0-9a38-4c3f-8005-466ab1297d12

	measure 'H SAU' = 26700000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: b1543b71-452a-484d-9979-2650f7d3003d

	measure 'Hectares équivalents gagnés' = [Hectares en agroforesterie (valeur)] * ( [Gain de surface retenu (valeur)] - 1 )
		formatString: #,0
		displayFolder: Agroforesterie
		lineageTag: 1218d44c-4d74-4682-ab10-9cdc65ce9d61

	measure 'Part de la surface agricole convertie' = DIVIDE ( [Hectares en agroforesterie (valeur)], [H SAU] )
		formatString: 0.0%
		displayFolder: Agroforesterie
		lineageTag: 0c1acf5e-b42b-47ea-9fe7-d8836d8a3d5b

	measure 'Azote de l''urine récupéré (t)' = [H excrétions] * [H part urine] * [Part de l'urine récupérée (valeur)]
		formatString: #,0
		displayFolder: Azote
		lineageTag: c75332ea-32f7-4c5f-aaa1-ba22179287ed

	measure 'Azote des effluents mieux valorisé (t)' = [H effluents] * [Part des effluents mieux valorisée (valeur)]
		formatString: #,0
		displayFolder: Azote
		lineageTag: 811f18ef-1c6d-421c-8d34-344c861768ea

	measure 'Azote économisé par les légumineuses (t)' = [Hectares de légumineuses en plus (valeur)] * [H légumineuses] / 1000
		formatString: #,0
		displayFolder: Azote
		lineageTag: 1a3698ee-3bba-4143-b11d-9f09a1a40f6d

	measure 'Azote total des leviers (t)' = [Azote de l'urine récupéré (t)] + [Azote des effluents mieux valorisé (t)] + [Azote économisé par les légumineuses (t)]
		formatString: #,0
		displayFolder: Azote
		lineageTag: cc0be121-b094-4fe0-80d0-619d09c01525

	measure 'Part des engrais azotés couverte' = DIVIDE ( [Azote total des leviers (t)], [H engrais] )
		formatString: 0.0%
		displayFolder: Azote
		lineageTag: ebaa8286-fe91-438e-a4da-2f56520c20ba

	measure 'Leviers / production française d''engrais' = DIVIDE ( [Azote total des leviers (t)], [H production engrais] )
		formatString: 0%
		displayFolder: Azote
		lineageTag: 843e7608-bfac-4c6c-bc6c-cdbbc35273d3

	measure 'Azote retiré par les moules (t)' = [Production de moules (t) (valeur)] * [H moules N] / 1000
		formatString: #,0
		displayFolder: Mer
		lineageTag: 73088cc2-4abc-44ed-8067-9662ed6c6431

	measure 'Part des pertes fluviales captées' = DIVIDE ( [Azote retiré par les moules (t)], [H fleuves] )
		formatString: 0.00%
		displayFolder: Mer
		lineageTag: 110d0134-d48b-415d-9a4b-4a0025e2f6e0

	measure 'Moules / production 2024' = DIVIDE ( [Production de moules (t) (valeur)], [H moules 2024] )
		formatString: 0.0
		displayFolder: Mer
		lineageTag: f4157b53-0f2c-4941-8f77-8b81fae370c8

