table Résultats
	lineageTag: bfd75319-03cc-4f87-aa0e-a043ec4db30b

	measure 'H engrais' = 2000000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 7ec414d6-2e59-4d56-a4d0-343901faada5

	measure 'H effluents' = 597500
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 051fd28c-e5ef-4d79-bd3f-ea8c5e76c409

	measure 'H légumineuses' = 40
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: fa1e988a-4b46-46ac-a7a3-c80d43a05a79

	measure 'H excrétions' = 300000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: f00c8961-6638-4e26-8b7c-c4fd774660cf

	measure 'H part urine' = 0.85
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 849c2737-5e68-4d95-a097-b655c508e2fd

	measure 'H algues' = 4.5
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: d1d29710-f042-4965-b903-a84fcffc504b

	measure 'H gain surface' = 1.34
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 88edd191-da04-40d4-94c1-999bab021d78

	measure 'H SAU' = 26700000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: b1a388ed-b88b-4aa8-968f-5fdad43e50dd

	measure 'Azote des effluents (t)' = [H effluents] * [Part des effluents d'élevage mieux utilisés (valeur)]
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 6b87fd00-5220-476f-89b7-5e2c27e043d7

	measure 'Azote des légumineuses (t)' = [Hectares de légumineuses en plus (valeur)] * [H légumineuses] / 1000
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 4c7809cb-7dfa-4988-9233-cff1f460378b

	measure 'Azote de l''urine (t)' = [H excrétions] * [H part urine] * [Part de l'urine collectée (valeur)]
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 89c1343e-8217-499b-a873-7f557a0a2e46

	measure 'Azote des algues (t)' = [Algues cultivées (t par an) (valeur)] * [H algues] / 1000
		formatString: #,0
		displayFolder: Leviers
		lineageTag: ad7eaa9f-9a07-440b-b9d6-a7d68edc8485

	measure 'Azote apporté (t)' = SWITCH ( SELECTEDVALUE ( Leviers[Ordre] ), 1, [Azote des effluents (t)], 2, [Azote des légumineuses (t)], 3, [Azote de l'urine (t)], 4, [Azote des algues (t)], [Azote des effluents (t)] + [Azote des légumineuses (t)] + [Azote de l'urine (t)] + [Azote des algues (t)] )
		formatString: #,0
		lineageTag: c3cd1c90-22af-4559-8984-a571dfaa5c57

	measure 'Engrais azotés remplacés' = DIVIDE ( [Azote apporté (t)], [H engrais] )
		formatString: 0%
		lineageTag: 73fb9b8b-3ee0-4220-9825-8d4f7eb0a756

	measure 'Hectares de production gagnés' = [Hectares en agroforesterie (valeur)] * ( [H gain surface] - 1 )
		formatString: #,0
		lineageTag: 2688e58a-d619-4dbd-87fc-e425f2c4c381

	column 'Clé'
		dataType: int64
		lineageTag: 72b7ceaa-5f51-4ac3-9e5e-438dd49541fc
		summarizeBy: none
		sourceColumn: [Value]

	partition Résultats = calculated
		mode: import
		source = { 1 }

