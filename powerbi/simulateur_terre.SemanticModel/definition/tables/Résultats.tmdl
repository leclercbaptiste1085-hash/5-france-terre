table Résultats
	lineageTag: c27e6f49-6f48-47b7-beda-9da092dffc5a

	measure 'H engrais' = 2000000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 83649273-8523-4f1b-8e56-3db647d285f1

	measure 'H effluents' = 597500
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 06b52c3f-2cd7-4f34-ac98-0378dff21444

	measure 'H légumineuses' = 40
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: b378b798-4e69-42b5-bf10-f1d858bb6b3e

	measure 'H excrétions' = 300000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: f46504b2-c31d-4d79-90ef-13f344308c5e

	measure 'H part urine' = 0.85
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: a508dee5-3b12-4f65-a2d1-a66b3eef7741

	measure 'H algues' = 4.5
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 492efce2-2cf0-4925-b0f0-021e90ec6da2

	measure 'H gain surface' = 1.34
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: 3aa555b8-e3a2-430b-9354-905f018716f4

	measure 'H SAU' = 26700000
		formatString: #,0.##
		displayFolder: Hypothèses
		lineageTag: c5472315-95b2-4cd6-8e21-844a7a033286

	measure 'Azote des effluents (t)' = [H effluents] * [Part des effluents d'élevage mieux utilisés (%) (valeur)] / 100
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 59e23e14-aedd-4c8c-b017-71f864bb076f

	measure 'Azote des légumineuses (t)' = [Hectares de légumineuses en plus (valeur)] * [H légumineuses] / 1000
		formatString: #,0
		displayFolder: Leviers
		lineageTag: f33ba9db-44a4-483a-aa35-316e9928386f

	measure 'Azote de l''urine (t)' = [H excrétions] * [H part urine] * [Part de l'urine collectée (%) (valeur)] / 100
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 1ccc0649-2b91-45ec-8494-63ba5fca022a

	measure 'Azote des algues (t)' = [Algues cultivées (t par an) (valeur)] * [H algues] / 1000
		formatString: #,0
		displayFolder: Leviers
		lineageTag: 209ff033-4ee9-4d65-a655-ed5b8363aca9

	measure 'Azote apporté (t)' = SWITCH ( SELECTEDVALUE ( Leviers[Ordre] ), 1, [Azote des effluents (t)], 2, [Azote des légumineuses (t)], 3, [Azote de l'urine (t)], 4, [Azote des algues (t)], [Azote des effluents (t)] + [Azote des légumineuses (t)] + [Azote de l'urine (t)] + [Azote des algues (t)] )
		formatString: #,0
		lineageTag: 16bef07d-11cd-460b-93a2-8bd97d0ffa7f

	measure 'Engrais azotés remplacés' = DIVIDE ( [Azote apporté (t)], [H engrais] )
		formatString: 0%
		lineageTag: e980de7c-e12c-4865-924f-829545ab75f3

	measure 'Hectares de production gagnés' = [Hectares en agroforesterie (valeur)] * ( [H gain surface] - 1 )
		formatString: #,0
		lineageTag: c176a936-f0d5-4a21-98aa-09573489c145

	column 'Clé'
		dataType: int64
		lineageTag: bf66f747-7600-4eb5-afda-2e1a448e407a
		summarizeBy: none
		sourceColumn: [Value]

	partition Résultats = calculated
		mode: import
		source = { 1 }

