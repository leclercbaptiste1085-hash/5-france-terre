table azote
	lineageTag: 1c34305f-a8a2-401f-8aca-0cbab9bf0336

	column 'flux'
		dataType: string
		lineageTag: f80f9bfb-7837-47c3-9d66-d0f1113522f9
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 1a8af065-b163-4230-92c0-c2f7f2824bed
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 8fcf39c7-25ca-443f-bd55-57db8481bb0c
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: 7f628d52-07fd-403e-826b-3f3357c298a8
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: d5c5c0ee-23e3-449b-a6d9-ab01d21c0d3b

