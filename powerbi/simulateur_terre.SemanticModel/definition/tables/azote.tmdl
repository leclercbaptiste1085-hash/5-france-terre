table azote
	lineageTag: f55e6d8b-113d-48e5-8800-383284d14e3c

	column 'flux'
		dataType: string
		lineageTag: 416ea9dc-000b-4c34-a5e4-f5d4ac8c6fe0
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 3c2bcb84-3a84-4488-bfcf-8e4bb9049c87
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 4d135081-0e34-4f62-b5c7-3e49b43da3a5
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: c5299ef4-318f-48eb-b737-ba25e3b7733e
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 8b1ec9db-465f-4bf5-8cd2-d040bb3721c8

