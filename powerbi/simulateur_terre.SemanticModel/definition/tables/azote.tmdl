table azote
	lineageTag: a437f6ab-ebdb-4c87-9cf0-0b46606dc772

	column 'flux'
		dataType: string
		lineageTag: f2487e45-4aa6-41b1-b4fe-0b3d7bd86750
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: ade99893-2405-49fd-861a-4355f716fa42
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 064e485d-6cda-4ffb-9220-2499d7a9cf1f
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: 8f5a1c3a-6047-4caf-aba2-81a39b4ec1a2
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 36f63282-83b3-45c6-9531-8e5c2c98c76d

