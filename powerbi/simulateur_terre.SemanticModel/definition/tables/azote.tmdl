table azote
	lineageTag: 90d8b477-22b6-458e-91cf-2c3bd3ab31b2

	column 'flux'
		dataType: string
		lineageTag: 52eaedf5-9dbb-4416-a3bb-f0fdedb85d9e
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 341b2282-442c-41fb-97fe-d896cd99b4a4
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 52b3d2c8-a382-4d4d-aea1-c2fc02c11ee9
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: e75b9bb4-4f93-4469-96a1-88f239618e8a
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: b6c21a3c-9099-46e5-b6f7-2bf3f2700550

