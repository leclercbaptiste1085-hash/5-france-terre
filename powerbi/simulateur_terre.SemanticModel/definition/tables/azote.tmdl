table azote
	lineageTag: 80747031-ab94-4f5d-a798-4bf75aa37e00

	column 'flux'
		dataType: string
		lineageTag: 22049c4f-5bb8-49ef-9cec-6d9d8c06c110
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 16ac026a-d1c4-4430-a979-e029a6f94928
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 3c5f4dd1-95f2-4b14-bd91-f76ffd5e2600
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: fc8cbd89-bda9-4487-8ec4-4c9433ef6298
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 57c39ccc-cdf9-4dd2-abee-9b23819cf709

