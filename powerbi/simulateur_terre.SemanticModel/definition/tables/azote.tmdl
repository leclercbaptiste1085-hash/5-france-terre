table azote
	lineageTag: 6f631f5a-4b31-43e9-8f4f-57c4560b78ca

	column 'flux'
		dataType: string
		lineageTag: 32064d28-ea13-4ea2-8f5f-41c82f9ded33
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 11a7f789-c844-4286-9587-350720ac7313
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: e95c06e9-02da-4fae-924d-62db40a6caff
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: c941de00-76bd-4a1c-bbf0-416c8ff2627e
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: ce057904-e4dc-410a-8da0-e467b028e464

