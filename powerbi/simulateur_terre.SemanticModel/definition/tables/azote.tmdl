table azote
	lineageTag: 00750bef-d739-4398-a0da-c0f3f963b39e

	column 'flux'
		dataType: string
		lineageTag: f052ab00-93ae-4a43-9be9-c2f2bca730b5
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 7b113d63-99a1-4293-be78-cdcffe2adc9f
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 43563088-c168-47ff-b64c-b91d32f7cc2c
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: 31158397-3eb9-422c-b129-d46a09a3408d
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 3d220219-25a6-4c06-86ed-a11c2b810481

