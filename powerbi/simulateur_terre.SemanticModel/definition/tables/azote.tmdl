table azote
	lineageTag: 17183e1b-7c8e-484a-a428-19b38b67220b

	column 'flux'
		dataType: string
		lineageTag: 4aa47659-2b30-4189-9f11-627f72ffdfbb
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		formatString: #,0.##
		lineageTag: dcd56e43-bd03-4551-87ce-d4a0cfafafa1
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 2f343f07-62f5-4f7f-9e93-138fea654757
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: fc31b543-5fac-4145-b955-f3b636cc4d70
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 52b8873d-aef1-4e1a-9573-7d8c11cdffc6

