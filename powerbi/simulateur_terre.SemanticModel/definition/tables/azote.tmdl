table azote
	lineageTag: 76610a32-4b8e-4b76-8470-8f018caf8158

	column 'flux'
		dataType: string
		lineageTag: 594600e7-4877-416d-a1f8-c4d0039164dc
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 15eb7283-225a-40ef-8309-34d5d611238c
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: ada5eaff-b68f-4dd9-bd96-9513d7f93e28
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: 15dff872-f066-4eb2-84e6-4be7cf4950f0
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: c79cdb7a-5a17-47c5-901e-f5bd2e152c65

