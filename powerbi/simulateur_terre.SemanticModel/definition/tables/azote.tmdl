table azote
	lineageTag: 6da27695-0868-41ed-b652-cb531bb1bc76

	column 'flux'
		dataType: string
		lineageTag: 822d6641-7911-423d-be1b-907551ac7995
		summarizeBy: none
		sourceColumn: flux

	column 'kt_n'
		dataType: double
		lineageTag: 79190c2a-f0bc-4224-9090-b3489136815b
		summarizeBy: sum
		sourceColumn: kt_n

	column 'groupe'
		dataType: string
		lineageTag: 2e84fc47-10e4-413c-82ff-6446b6c8d0d9
		summarizeBy: none
		sourceColumn: groupe

	column 'source'
		dataType: string
		lineageTag: 962725f9-ae5e-4bae-87be-dec4c77322ad
		summarizeBy: none
		sourceColumn: source

	partition azote = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "ordres_grandeur_azote.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"flux", type text}, {"kt_n", type number}, {"groupe", type text}, {"source", type text}}, "en-US")
				in
				    Types

	measure 'Azote (t)' = SUM ( azote[kt_n] ) * 1000
		formatString: #,0
		lineageTag: 67e465c1-2909-46f1-89aa-2ae06761fc95

