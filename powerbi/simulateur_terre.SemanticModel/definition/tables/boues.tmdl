table boues
	lineageTag: 31f9c2f1-cc98-4170-a106-225ee34d242f

	column 'pays'
		dataType: string
		lineageTag: d523b4e2-0ea5-48f0-923b-dd9b1f252075
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 7a39032c-a538-4e54-a9ee-92c34bf1b3f0
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: 76aff4bd-54b5-45f4-9b26-49f315f8e9d6
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: d0335697-d4c8-462b-8fb8-8cf4e89248bf
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: ffa1e208-3598-4f17-a50c-6c2e01c52fcc
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: 237813d4-40e6-40f5-ad93-8aedadb71d01
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 31a39de6-3223-4b68-acb0-936679405000
		summarizeBy: sum
		sourceColumn: decharge

	column 'autre'
		dataType: double
		lineageTag: a469887f-3b51-4880-883b-2529cd266bcb
		summarizeBy: sum
		sourceColumn: autre

	partition boues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "eurostat_boues_pays.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"pays", type text}, {"annee", type number}, {"total_kt", type number}, {"agriculture", type number}, {"compost", type number}, {"incineration", type number}, {"decharge", type number}, {"autre", type number}}, "en-US")
				in
				    Types

	measure 'Part des boues rendue au sol' = CALCULATE ( DIVIDE ( SUM ( boues[agriculture] ) + SUM ( boues[compost] ), SUM ( boues[total_kt] ) ), boues[annee] >= 2019 )
		formatString: 0%
		lineageTag: 127ea3f4-6082-425d-b8c0-15375c5a6bd3

