table boues
	lineageTag: 57e4f67b-385c-4ddc-a6b5-c725b23667ef

	column 'pays'
		dataType: string
		lineageTag: 64b15851-bfeb-4e5b-997f-e7a11c1eaaf6
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 8a2ea0df-1dd6-4733-a3d7-1b1acb39d502
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: 89b53dd4-c1d3-45ef-bfab-c2415a0112f5
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: 69107b21-e8df-4ae3-ac52-f37c3bf10a76
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: d96fa6b3-5264-4f1e-b764-d656486db51c
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: fb2ce3d4-eebb-4842-ad9c-05c6a6d86652
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 51ca7ed0-b0b4-4d1f-b87d-6f44032220f9
		summarizeBy: sum
