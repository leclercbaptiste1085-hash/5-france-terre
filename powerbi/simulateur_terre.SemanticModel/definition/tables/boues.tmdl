table boues
	lineageTag: 8634976d-ad88-42e3-ba71-6fa11f76d6bb

	column 'pays'
		dataType: string
		lineageTag: 77d595d9-805a-4410-8015-a510f8e0439f
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 2b69fd43-4156-4db0-a03c-62a38f7967b7
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: eb564cd0-eaa8-40e0-a088-ac564ecc3b97
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: 29f1c47f-cad7-4916-b2d0-e52d5400a97d
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: 1be97cde-8175-4c08-ba7f-de58b09e32f9
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: 3bd3edfc-f986-4fb4-8d83-d19650535f2f
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 782f10fc-3ded-42cd-af88-7acbf104ac79
		summarizeBy: sum
		sourceColumn: decharge

	column 'autre'
		dataType: double
		lineageTag: e7543833-d46e-464d-8032-8db423c5bdd0
		summarizeBy: sum
		sourceColumn: autre

	partition boues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "eurostat_boues_pays.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"pays", type text}, {"annee", type number}, {"total_kt", type number}, {"agriculture", type number}, {"compost", type number}, {"incineration", type number}, {"decharge", type number}, {"autre", type number}}, "en-US")
				in
				    Types

	measure 'Part des boues rendue au sol' = CALCULATE ( DIVIDE ( SUM ( boues[agriculture] ) + SUM ( boues[compost] ), SUM ( boues[total_kt] ) ), boues[annee] >= 2019 )
		formatString: 0%
		lineageTag: 714ef72e-c0aa-405f-a433-fa276d96b389

