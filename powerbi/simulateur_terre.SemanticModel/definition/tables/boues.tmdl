table boues
	lineageTag: 3e5ecf64-10a9-4f7f-a830-c416e68b55e4

	column 'pays'
		dataType: string
		lineageTag: d2dfcc28-0ecd-41a6-ac80-aae78de94542
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 16259a6c-5bbc-49a5-b1ea-58bf32551c07
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: e104fc37-5642-4777-bf60-1aab72f57ee4
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: 3fd68ffe-7726-498a-9612-3ab5cc433046
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: 7b5ec5a0-92c8-4fc1-b5f8-417a2058218e
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: 9e42a5c8-d9a2-4c2a-b827-2f7929a8a807
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 4c940614-07df-4bf9-9a54-d883a614b8b7
		summarizeBy: sum
		sourceColumn: decharge

	column 'autre'
		dataType: double
		lineageTag: fefcbe8e-b08a-48ea-8e67-94409483135d
		summarizeBy: sum
		sourceColumn: autre

	partition boues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "eurostat_boues_pays.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"pays", type text}, {"annee", type number}, {"total_kt", type number}, {"agriculture", type number}, {"compost", type number}, {"incineration", type number}, {"decharge", type number}, {"autre", type number}}, "en-US")
				in
				    Types

	measure 'Part des boues rendue au sol' = CALCULATE ( DIVIDE ( SUM ( boues[agriculture] ) + SUM ( boues[compost] ), SUM ( boues[total_kt] ) ), boues[annee] >= 2019 )
		formatString: 0%
		lineageTag: 436df151-b842-4d22-80e8-51798ca49d3c

