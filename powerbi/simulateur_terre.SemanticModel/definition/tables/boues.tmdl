table boues
	lineageTag: d0c135df-3b04-4b94-a5e1-72f93c7ed21b

	column 'pays'
		dataType: string
		lineageTag: f63d4a4a-2588-493a-b00e-2abf9ec27e6f
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 83fd4d98-cbc4-4b7b-b8f7-ac38e76794a2
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: a47eafc8-bbb1-4c13-8e39-2ca957758bdb
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: 9c04ab00-e15c-48a4-8522-3bdc2a79656e
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: 9f64e246-5338-43d4-a763-d85a8d7c837b
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: 85642949-de2e-4bbe-a31c-40c8175b8a97
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 4b99fba5-2166-4cb6-a1a4-91a2f9d5c8ad
		summarizeBy: sum
		sourceColumn: decharge

	column 'autre'
		dataType: double
		lineageTag: 3bcf6035-7135-418c-8b65-77bfc3851387
		summarizeBy: sum
		sourceColumn: autre

	partition boues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "eurostat_boues_pays.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"pays", type text}, {"annee", type number}, {"total_kt", type number}, {"agriculture", type number}, {"compost", type number}, {"incineration", type number}, {"decharge", type number}, {"autre", type number}}, "en-US")
				in
				    Types

	measure 'Part des boues rendue au sol' = CALCULATE ( DIVIDE ( SUM ( boues[agriculture] ) + SUM ( boues[compost] ), SUM ( boues[total_kt] ) ), boues[annee] >= 2019 )
		formatString: 0%
		lineageTag: b6b58126-b02f-41e3-a9a8-df28dcbf0646

