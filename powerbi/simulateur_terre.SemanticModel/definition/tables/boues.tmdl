table boues
	lineageTag: 221b6547-0dd9-4f9a-bb7d-413e7510f830

	column 'pays'
		dataType: string
		lineageTag: 9626806e-02e8-4d65-a417-7d541993648c
		summarizeBy: none
		sourceColumn: pays

	column 'annee'
		dataType: double
		lineageTag: 9b98da7c-50ed-4307-bee0-2fd051d5c194
		summarizeBy: sum
		sourceColumn: annee

	column 'total_kt'
		dataType: double
		lineageTag: d3be1600-2b39-4c69-8c9f-1b45a92f1d9d
		summarizeBy: sum
		sourceColumn: total_kt

	column 'agriculture'
		dataType: double
		lineageTag: f81d7430-725c-4b94-8b13-7a89f22137b3
		summarizeBy: sum
		sourceColumn: agriculture

	column 'compost'
		dataType: double
		lineageTag: d7e1535b-6f6c-4f3a-ad59-1d956a1ec6f4
		summarizeBy: sum
		sourceColumn: compost

	column 'incineration'
		dataType: double
		lineageTag: 6f23e134-b3fa-4b40-9232-afebfdcc4160
		summarizeBy: sum
		sourceColumn: incineration

	column 'decharge'
		dataType: double
		lineageTag: 5447d5c3-cd04-44bb-8173-2eb42afcff74
		summarizeBy: sum
		sourceColumn: decharge

	column 'autre'
		dataType: double
		lineageTag: e6808428-6f47-4b50-9640-49afafe47658
		summarizeBy: sum
		sourceColumn: autre

	partition boues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "eurostat_boues_pays.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"pays", type text}, {"annee", type number}, {"total_kt", type number}, {"agriculture", type number}, {"compost", type number}, {"incineration", type number}, {"decharge", type number}, {"autre", type number}}, "en-US")
				in
				    Types

	measure 'Part des boues rendue au sol' = CALCULATE ( DIVIDE ( SUM ( boues[agriculture] ) + SUM ( boues[compost] ), SUM ( boues[total_kt] ) ), boues[annee] >= 2019 )
		formatString: 0%
		lineageTag: 8f59367a-3c1e-45b6-a1c2-d938799f786e

