table 'Leviers'
	lineageTag: fa0ee59c-1d9d-4da4-8183-e27aa2384c6b

	column 'Ordre'
		dataType: int64
		lineageTag: eec46d5e-c92b-46a6-80b5-61918608562f
		summarizeBy: none
		sourceColumn: [Ordre]

	column 'Levier'
		dataType: string
		lineageTag: ea4fd085-ce27-4e38-89a5-e43af2cc2874
		summarizeBy: none
		sourceColumn: [Levier]
		sortByColumn: Ordre

	partition 'Leviers' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 5, 1 ), "Ordre", [Value], "Levier", SWITCH ( [Value], 1, "Pertes d'ammoniac évitées", 2, "Urine collectée", 3, "Légumineuses", 4, "Algues cultivées", 5, "Reste à importer ou produire" ) )

