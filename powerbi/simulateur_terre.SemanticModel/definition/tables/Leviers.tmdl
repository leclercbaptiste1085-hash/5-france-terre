table Leviers
	lineageTag: f3ae2400-2655-435a-982a-0cc09f02f70b

	column 'Ordre'
		dataType: int64
		lineageTag: 844f7ded-b55d-40d0-9f40-b75fd4d62f7d
		summarizeBy: none
		sourceColumn: [Ordre]

	column 'Levier'
		dataType: string
		lineageTag: 4f78f864-83f6-47a0-a083-031f8d155101
		summarizeBy: none
		sourceColumn: [Levier]

	partition Leviers = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 4, 1 ), "Ordre", [Value], "Levier", SWITCH ( [Value], 1, "Effluents d'élevage", 2, "Légumineuses", 3, "Urine collectée", 4, "Algues cultivées" ) )

