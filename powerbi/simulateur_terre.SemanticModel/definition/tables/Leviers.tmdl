table 'Leviers'
	lineageTag: a38b4274-7bc0-4489-9548-549945ca713b

	column 'Ordre'
		dataType: int64
		lineageTag: 046e5409-92d6-438a-8a50-0cb8d076687d
		summarizeBy: none
		sourceColumn: [Ordre]

	column 'Levier'
		dataType: string
		lineageTag: b4524a2b-941e-486b-9900-56dfe8bf57db
		summarizeBy: none
		sourceColumn: [Levier]
		sortByColumn: Ordre

	partition 'Leviers' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 5, 1 ), "Ordre", [Value], "Levier", SWITCH ( [Value], 1, "Pertes d'ammoniac évitées", 2, "Urine collectée", 3, "Légumineuses", 4, "Algues cultivées", 5, "Reste à importer ou produire" ) )

